# Copy to docker/.env (git-ignored) and edit. Never commit the real file.

# REQUIRED. Long random key; people need it to create a room.
#   openssl rand -base64 32
CREATE_KEY=

# Public origin as users see it (https://... behind a proxy). Used in join
# snippets and as an extra allowed WebSocket Origin.
PUBLIC_URL=http://localhost:3000

# 1/true only when a reverse proxy in front sets X-Forwarded-For (the server
# uses the LAST entry). Leave false if the port is reachable directly.
TRUST_PROXY=false

# REQUIRED. Password of the bundled Postgres (permanent rooms). Hex only: it is
# placed inside DATABASE_URL.   openssl rand -hex 24
POSTGRES_PASSWORD=

# Host port, bound to 127.0.0.1 only.
HOST_PORT=3000

ROOM_TTL_SECONDS=3600
# Stored message bytes budget (256 MB). Heap use is higher; compose mem_limit stays >= 768m.
MAX_TOTAL_BYTES=268435456
# Room creations per IP per hour; only matters without CREATE_KEY
ROOMS_PER_IP_PER_HOUR=5
MAX_ROOMS=1000
MCP_CALLS_PER_MINUTE=120
CREATE_ROOMS=true
LOG_LEVEL=info
